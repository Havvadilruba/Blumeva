
<div class="top-bar">
  <% if (!user) { %>
    <a href="/login">Login</a>
    <a href="/signup" class="signup">Sign Up</a>
  <% } else { %>
    <span>Welcome, <%= user.name %></span>
    <a href="/logout">Logout</a>
  <% } %>
  <a href="#">Contact Us</a>
</div>


<div class="middle-bar">

  <div class="logo">
    <img src="/images/Frame.svg" alt="Logo" class="logo-icon" />
    <span>Blumeva</span>
  </div>


  <div class="search-icons">
    <form action="/products" method="GET">
      <input type="text" name="search" placeholder="Search" class="search-box" value="<%= typeof query !== 'undefined' ? query : '' %>" />
      <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
    </form>

    <div class="icon-links">
  <a href="/wishlist"><i class="fa-regular fa-heart"></i></a>
  <a href="/cart"><i class="fa-solid fa-cart-shopping"></i></a>

  <% if (user) { %>
   
    <a href="/profile">
      <% if (user.avatar) { %>
        <img src="<%= user.avatar %>" alt="Profile" class="profile-img" />
      <% } else { %>
        <i class="fa-regular fa-user"></i>
      <% } %>
    </a>
  <% } else { %>
    
    <a href="/login"><i class="fa-regular fa-user"></i></a>
  <% } %>
</div>
  </div>
</div>


<nav class="bottom-nav">
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="/products">Products</a></li>
    <li><a href="/combo">Combo</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>
