
<div class="top-bar">
  <% if (!user) { %>
    <a href="/login">Login</a>
    <a href="/signup" class="signup">Sign Up</a>
  <% } else { %>
    <span>Welcome, <%= user.name %></span>
   <form action="/logout" method="POST">
  <button>Logout</button>
</form>

  <% } %>
  <a href="/contact">Contact Us</a>
</div>


<div class="middle-bar">

  <!-- Logo -->
  <div class="logo">
    <img
  src="https://res.cloudinary.com/dtazbbayi/image/upload/v1768148645/Blumeva_Logo_dqrvhx.svg"
  alt="Blumeva"
  class="logo-icon"
/>


    <span>Blumeva</span>
  </div>

  <!-- Search + Icons (RIGHT SIDE) -->
  <div class="search-icons">

    <!-- Live Search -->
    <div class="header-search-form">
      <div class="search-wrapper">
        <input
          type="text"
          id="headerSearchInput"
          placeholder="Search products..."
          class="search-box"
          autocomplete="off"
        />

        <!-- Clear button -->
        <button
          type="button"
          id="clearSearchBtn"
          class="clear-search-btn"
          aria-label="Clear search">
          ✕
        </button>
      </div>
    </div>

    <!-- Icons -->
    <div class="icon-links">

      <!-- Wishlist -->
      <a href="/wishlist" class="icon-wrapper">
        <i class="fa-regular fa-heart"></i>
        <% if (wishlistCount > 0) { %>
          <span class="icon-badge"><%= wishlistCount %></span>
        <% } %>
      </a>

      <!-- Cart -->
      <a href="/cart" class="icon-wrapper">
        <i class="fa-solid fa-cart-shopping"></i>
        <% if (cartCount > 0) { %>
          <span class="icon-badge"><%= cartCount %></span>
        <% } %>
      </a>

      <!-- Profile -->
      <% if (user) { %>
        <a href="/profile">
          <% if (user.avatar) { %>
            <img src="<%= user.avatar %>" class="profile-img" />
          <% } else { %>
            <i class="fa-regular fa-user"></i>
          <% } %>
        </a>
      <% } else { %>
        <a href="/login"><i class="fa-regular fa-user"></i></a>
      <% } %>

    </div>
  </div>

</div>



<nav class="bottom-nav">
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="/products">Products</a></li>
    <li><a href="/contact">Contact</a></li>
    <li><a href="/about">About</a></li>
  </ul>
</nav>

<script>
const searchInput = document.getElementById("headerSearchInput");
const clearBtn = document.getElementById("clearSearchBtn");

let searchTimer = null;

function debounce(callback, delay = 300) {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(callback, delay);
}

/* Restore search on refresh */
document.addEventListener("DOMContentLoaded", () => {
  const url = new URL(window.location);
  const search = url.searchParams.get("search");

  if (search && searchInput) {
    searchInput.value = search;
    clearBtn.style.display = "block";
  }
});

/* Live search */
searchInput?.addEventListener("input", () => {
  const value = searchInput.value.trim();
  clearBtn.style.display = value ? "block" : "none";

  debounce(() => {
    const url = new URL(window.location);

    if (value) {
      url.searchParams.set("search", value);
      url.searchParams.set("page", 1);
    } else {
      url.searchParams.delete("search");
      url.searchParams.delete("page");
    }

    window.history.pushState({}, "", url);

    const isProductPage = window.location.pathname === "/products";

    if (isProductPage && typeof fetchProducts === "function") {
      fetchProducts(); // AJAX update
    } else {
      window.location.href =`/products?search=${encodeURIComponent(value)}`
    }
  });
});

/* Clear search */
clearBtn?.addEventListener("click", () => {
  searchInput.value = "";
  clearBtn.style.display = "none";

  const url = new URL(window.location);
  url.searchParams.delete("search");
  url.searchParams.delete("page");

  window.history.pushState({}, "", url);

  const isProductPage = window.location.pathname === "/products";

  if (isProductPage && typeof fetchProducts === "function") {
    fetchProducts();
  } else {
    window.location.href = "/products";
  }

  searchInput.focus();
});
</script>
