      <li><a href="#"><i class="ri-gift-line"></i><span>Referrals</span></a></li>
    </ul>
  </div>

  <div>
    <div class="profile">
      <img src="https://via.placeholder.com/45" alt="Admin Profile">
      <div class="profile-info">
        <h4>Admin</h4>
        <p>admin@blumeva.com</p>
      </div>
    </div>

    <form id="logoutForm" action="/admin/logout" method="POST">
      <button type="submit" class="logout">
        <i class="ri-logout-box-r-line"></i><span>Logout</span>
      </button>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll('.toggle-submenu').forEach(item => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const submenu = item.nextElementSibling;
      submenu.classList.toggle('open');
      item.querySelector('.arrow').classList.toggle('rotate');
    });
  });
</script>
