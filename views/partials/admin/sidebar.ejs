    <a href="/admin/category" class="<%= activePage === 'categoryList' ? 'active' : '' %>">
      <i class="ri-list-unordered"></i><span>Category List</span>
    </a>
    <a href="/admin/category/add" class="<%= activePage === 'addCategory' ? 'active' : '' %>">
      <i class="ri-add-line"></i><span>Add Category</span>
    </a>
  </div>
</li>

<li class="dropdown">
  <a href="#" class="toggle-submenu">
    <i class="ri-shopping-bag-line"></i><span>Products</span>
    <i class="ri-arrow-down-s-line arrow"></i>
  </a>
  <div class="submenu">
    <a href="/admin/products" class="<%= activePage === 'productList' ? 'active' : '' %>">
      <i class="ri-list-check-2"></i><span>Product List</span>
    </a>
    <a href="/admin/products/add" class="<%= activePage === 'addProduct' ? 'active' : '' %>">
      <i class="ri-add-line"></i><span>Add Product</span>
    </a>
  </div>
