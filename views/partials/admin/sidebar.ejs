</a></li>

      <li><a href="/admin/salesReport" class="<%= activePage === 'salesReport' ? 'active' : '' %>">
  <i class="ri-line-chart-line"></i><span>Sales Report</span>
</a></li>

<li class="dropdown">
  <a href="#" class="toggle-submenu">
