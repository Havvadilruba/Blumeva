    <div class="skin-grid">
      <div class="skin-box">
        <h4>Normal</h4>
        <p>Balanced, not too oily or dry. Minimal blemishes and even tone.</p>
      </div>
      <div class="skin-box">
        <h4>Oily</h4>
        <p>Produces excess sebum, leading to a shiny appearance and clogged pores.</p>
      </div>
      <div class="skin-box">
        <h4>Dry</h4>
        <p>Lacks moisture, often feels tight or flaky, may show fine lines.</p>
      </div>
      <div class="skin-box">
        <h4>Combination</h4>
        <p>Oily in T-zone (forehead, nose, chin) and dry or normal elsewhere.</p>
      </div>
    </div>
  </section>

