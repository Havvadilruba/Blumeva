<%- include("../partials/user/header") %>

<!-- Breadcrumbs -->
<nav class="breadcrumb">
  <a href="/"><i class="fa-solid fa-house"></i> Home</a>
  <span class="separator">›</span>
  <span class="current">Contact Us</span>
</nav>

<!-- Contact Page -->
<section class="contact-page">
  
  <!-- Hero Section -->
  <div class="contact-hero">
    <div class="hero-content">
      <h1>Get In Touch</h1>
      <p>We're here to help you find the perfect piece of jewelry</p>
    </div>
  </div>

  <div class="contact-container">

    <!-- Contact Information Cards -->
    <div class="contact-grid">
      
      <!-- Contact Info Section -->
      <div class="contact-info-section">
        
        <!-- Phone Card -->
        <div class="info-card">
          <div class="info-icon">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div class="info-content">
            <h3>Phone</h3>
            <p class="info-subtitle">Call us for instant support</p>
            <a href="tel:+919876543210" class="info-link">+91 98765 43210</a>
            <p class="info-time">Mon-Sat: 10:00 AM - 8:00 PM IST</p>
          </div>
        </div>

        <!-- Email Card -->
        <div class="info-card">
          <div class="info-icon">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <div class="info-content">
            <h3>Email</h3>
            <p class="info-subtitle">Send us an email anytime</p>
            <a href="mailto:support@blumeva.com" class="info-link">support@blumeva.com</a>
            <p class="info-time">We'll respond within 24 hours</p>
          </div>
        </div>

        <!-- WhatsApp Card -->
        <div class="info-card">
          <div class="info-icon">
            <i class="fa-brands fa-whatsapp"></i>
          </div>
          <div class="info-content">
            <h3>WhatsApp</h3>
            <p class="info-subtitle">Chat with us instantly</p>
            <a href="https://wa.me/919876543210" target="_blank" class="info-link">+91 98765 43210</a>
            <p class="info-time">Quick responses guaranteed</p>
          </div>
        </div>

        <!-- Address Card -->
        <div class="info-card">
          <div class="info-icon">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div class="info-content">
            <h3>Visit Our Showroom</h3>
            <p class="info-subtitle">Experience luxury in person</p>
            <p class="info-address">
              Blumeva Jewellers<br>
              123, Brigade Road<br>
              Bangalore, Karnataka 560001<br>
              India
            </p>
          </div>
        </div>

      </div>

      <!-- Map & Additional Info Section -->
      <div class="additional-info-section">
        
        <!-- Map -->
        <div class="map-container">
          <div class="map-placeholder">
            <i class="fa-solid fa-map-location-dot"></i>
            <p class="map-title">Our Location</p>
            <p class="map-address">123, Brigade Road, Bangalore</p>
          </div>
        </div>

        <!-- Social Media -->
        <div class="social-card">
          <h3>Connect With Us</h3>
          <p>Follow us for exclusive collections, offers, and jewelry inspiration</p>
          <div class="social-links">
            <a href="#" class="social-link" aria-label="Facebook">
              <i class="fa-brands fa-facebook-f"></i>
            </a>
            <a href="#" class="social-link" aria-label="Instagram">
              <i class="fa-brands fa-instagram"></i>
            </a>
            <a href="#" class="social-link" aria-label="Twitter">
              <i class="fa-brands fa-twitter"></i>
            </a>
            <a href="#" class="social-link" aria-label="Pinterest">
              <i class="fa-brands fa-pinterest-p"></i>
            </a>
            <a href="#" class="social-link" aria-label="YouTube">
              <i class="fa-brands fa-youtube"></i>
            </a>
          </div>
        </div>

        <!-- Business Hours -->
        <div class="hours-card">
          <h3>
            <i class="fa-solid fa-clock"></i>
            Showroom Hours
          </h3>
          <div class="hours-list">
            <div class="hours-item">
              <span class="day">Monday - Friday</span>
              <span class="time">10:00 AM - 8:00 PM</span>
            </div>
            <div class="hours-item">
              <span class="day">Saturday</span>
              <span class="time">10:00 AM - 9:00 PM</span>
            </div>
            <div class="hours-item">
              <span class="day">Sunday</span>
              <span class="time">11:00 AM - 7:00 PM</span>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Support Options -->
    <div class="support-section">
      <h2>How Can We Help You?</h2>
      <div class="support-grid">
        
        <div class="support-card">
          <div class="support-icon">
            <i class="fa-solid fa-circle-question"></i>
          </div>
          <h3>FAQs</h3>
          <p>Find quick answers to common questions about our jewelry, orders, and policies.</p>
          <a href="/faq" class="support-link">
            View FAQs <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="support-card">
          <div class="support-icon">
            <i class="fa-solid fa-gem"></i>
          </div>
          <h3>Product Care</h3>
          <p>Learn how to maintain and care for your precious jewelry pieces.</p>
          <a href="/care-guide" class="support-link">
            Care Guide <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

        <div class="support-card">
          <div class="support-icon">
            <i class="fa-solid fa-rotate-left"></i>
          </div>
          <h3>Returns & Exchange</h3>
          <p>Easy 7-day return and exchange policy for your peace of mind.</p>
          <a href="/returns" class="support-link">
            Learn More <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>

      </div>
    </div>

    <!-- CTA Section -->
    <div class="cta-section">
      <div class="cta-content">
        <i class="fa-solid fa-sparkles"></i>
        <h2>Discover Timeless Elegance</h2>
        <p>Explore our exquisite collection of handcrafted jewelry pieces that celebrate your unique style</p>
        <a href="/products" class="cta-button">
          <i class="fa-solid fa-bag-shopping"></i>
          <span>Shop Now</span>
        </a>
      </div>
    </div>

  </div>
</section>

<%- include("../partials/user/footer") %>