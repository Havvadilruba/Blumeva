<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password | Blumeva</title>
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  
  <!-- Toastify CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />
  
  <!-- Forgot Password CSS -->
  <link rel="stylesheet" href="/style/user/forgotPassword.css" />
</head>
<body>
  <div class="container">
    <!-- Header Logo -->
    <header class="signup-header">
      <a href="/" class="logo">
        <img src="/images/Frame.svg" alt="Blumeva Logo" class="logo-icon" />
        <span>Blumeva</span>
      </a>
    </header>

    <!-- Card -->
    <div class="card">
      <!-- Icon -->
      <div class="icon-section">
        <div class="forgot-icon">
          <i class="fa-solid fa-key"></i>
        </div>
      </div>

      <!-- Heading -->
      <h2>Forgot Your Password?</h2>
      <p class="sub-text">Enter your email to receive a password reset link</p>

      <!-- Form -->
      <form id="forgotForm" class="forgot-form">
        <div class="form-group">
          <label for="email">
            <i class="fa-regular fa-envelope"></i>
            Email Address
          </label>
          <input 
            type="email" 
            id="email" 
            name="email"
            placeholder="Enter your email" 
            required 
            autocomplete="email"
          />
        </div>
        <button type="submit" class="verify-btn">
          <span>Verify Email</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <!-- Back Link -->
      <div class="links">
        <a href="/login" class="back-link">
          <i class="fa-solid fa-arrow-left"></i>
          Back to Login
        </a>
      </div>

      <!-- Footer -->
      <footer class="card-footer">
        <p>We'll send you a secure link to reset your password</p>
      </footer>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script>
    document.getElementById("forgotForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = document.getElementById("email").value.trim();
      try {
        const res = await axios.post("/forgot-password", { email });
        const data = res.data;
        Toastify({
          text: data.message,
          backgroundColor: data.success ? "#C9A45C" : "#DC2626",
          duration: 2500,
          gravity: "top",
          position: "right",
          stopOnFocus: true,
        }).showToast();
        if (data.success) setTimeout(() => window.location.href = data.redirectUrl, 1200);
      } catch (err) {
        const msg = err.response?.data?.message || "Something went wrong";
        Toastify({ 
          text: msg, 
          backgroundColor: "#DC2626", 
          duration: 2500,
          gravity: "top",
          position: "right",
          stopOnFocus: true,
        }).showToast();
      }
    });
  </script>
</body>
</html>
