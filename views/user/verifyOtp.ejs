<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify OTP - Blumeva</title>
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
  <link rel="stylesheet" href="/style/user/verifyOtp.css" />
</head>
<body>
  <div class="container">
    <h1 class="brand">Blumeva</h1>

    <div class="card">
     <h2><%= isReset ? "Verify OTP to Reset Password" : "Verify Your Account" %></h2>
<p class="sub-text">
  <%= isReset
      ? "An OTP has been sent to your email to reset your password."
      : "An OTP has been sent to your email to verify your account." %>
</p>
<p class="email"><%= email %></p>

<form
  action="<%= isReset ? '/verify-reset' : '/verifyOtp' %>"
  method="POST"
  class="otp-form"
  onsubmit="return validateOTPForm(event)"
>
  <div class="otp-inputs">
    <input type="text" maxlength="1" id="otp1" />
    <input type="text" maxlength="1" id="otp2" />
    <input type="text" maxlength="1" id="otp3" />
    <input type="text" maxlength="1" id="otp4" />
    <input type="text" maxlength="1" id="otp5" />
    <input type="text" maxlength="1" id="otp6" />
  </div>
  <button type="submit" class="btn">Verify OTP</button>
</form>

<div class="links">
  <p class="timer-text">
    Didn’t receive the OTP? <span id="timer">01:00</span>
  </p>
  <a
    href="<%= isReset ? '/resend-reset' : '/resendOtp' %>"
    id="resendOtp"
    class="disabled"
    onclick="return resendOtp(event)"
  >
    Resend OTP
  </a>
  <a href="<%= isReset ? '/forgot-password' : '/signup' %>" class="back-link">
    ← Back
  </a>
</div>

      </div>
    </div>

  </div>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/user/verifyOtp.js"></script>
</body>
</html>

