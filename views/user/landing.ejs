<%- include("../../views/partials/user/header") %>

<% if (banner) { %>
<section class="landing-hero">
  <img src="<%= banner.image %>" alt="<%= banner.title %>">
  <div class="hero-text">
    <h1><%= banner.title %></h1>

    <% if (banner.description) { %>
      <p><%= banner.description %></p>
    <% } %>

    <a href="<%= banner.link %>" class="btn">
      <%= banner.ctaText || 'Shop Now' %>
    </a>
  </div>
</section>
<% } %>


<section class="about">
  <h2>What is Blumeva?</h2>
  <p>Experience the purity of nature with advanced skincare science.</p>
</section>

<!-- Categories -->
<section class="categories">
  <h2>Shop by Category</h2>
  <div class="category-grid">
  <% categories.forEach(category => { %>
    <a href="/products?category=<%= category.name %>" class="category">
      <img src="<%= category.image %>" alt="<%= category.name %>">
      <p><%= category.name %></p>
    </a>
  <% }) %>
</div>
</section>

<section class="latest">
  <h2>Latest Products</h2>
  <div class="product-grid">
  <% if (latestProducts.length === 0) { %>
    <p>No products found.</p>
  <% } %>

  <% latestProducts.forEach(product => { %>
    <%- include("../partials/user/productCard", { product }) %>
  <% }) %>
</div>

</section>



<!--Coupon -->
<div class="newsletter">
  <h3>🎉 Get 10% OFF your first order!</h3>
  <p>Use code <span class="discount">WELCOME10</span> at checkout and enjoy exclusive updates.</p>
  <div class="newsletter-box">
     <a href="<%= user ? '/products' : '/signup' %>" class="btn">Shop Now</a>
  </div>
</div>



<!-- Skin Type -->
<section class="skin-type">
  <h2>Understand Your Skin Type</h2>
  <div class="skin-grid">
    <div class="skin-box">
      <img src="https://res.cloudinary.com/dtazbbayi/image/upload/v1769672613/PRQL_Blog_Hero_NormalSkin_lh9542.webp" alt="Normal Skin" />
      <h4>Normal</h4>
      <p>Balanced, not too oily or dry. Minimal blemishes and even tone.</p>
    </div>
    <div class="skin-box">
      <img src="https://res.cloudinary.com/dtazbbayi/image/upload/v1769672656/PRQL_Blog_Hero_OilySkin_tvqpkd.webp" alt="Oily Skin" />
      <h4>Oily</h4>
      <p>Produces excess sebum, leading to a shiny appearance and clogged pores.</p>
    </div>
    <div class="skin-box">
      <img src="https://res.cloudinary.com/dtazbbayi/image/upload/v1769672643/istockphoto-467680200-612x612_l8boxo.jpg" alt="Dry Skin" />
      <h4>Dry</h4>
      <p>Lacks moisture, often feels tight or flaky, may show fine lines.</p>
    </div>
    <div class="skin-box">
      <img src="https://res.cloudinary.com/dtazbbayi/image/upload/v1769672630/PRQL_Blog_Hero_CombinationSkin_1_lelbuq.jpg" alt="Combination Skin" />
      <h4>Combination</h4>
      <p>Oily in T-zone (forehead, nose, chin) and dry or normal elsewhere.</p>
    </div>
  </div>
</section>

<!-- Brands -->
<section class="brands">
  <h2>Brands</h2>
  <div class="brand-grid">
    <% brands.forEach(brand => { %>
      <div class="brand-card">
        <img src="<%= brand.logo %>" alt="<%= brand.name %>" />
        <p><%= brand.name %></p>
      </div>
    <% }) %>
  </div>
</section>



<%- include("../../views/partials/user/footer") %>
<script>
  function goToProduct(productId) {
  window.location.href = `/product/${productId}`;
}
</script>