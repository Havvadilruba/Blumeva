<%- include("../../views/partials/user/header") %>

<section class="landing-hero">
  <img src="/images/mainimage.jpg" alt="Hero" />
  <div class="hero-text">
    <h1>Pure Care for Your Face</h1>
    <p>Discover the beauty of healthy skin.</p>
    <a href="<%= user ? '/products' : '/signup' %>" class="btn">Get Started</a>
  </div>
</section>

<section class="about">
  <h2>Why Blumeva?</h2>
  <p>Experience the purity of nature with advanced skincare science.</p>
</section>

<!-- Categories -->
<section class="categories">
  <h2>Shop by Category</h2>
  <div class="category-grid">
  <% categories.forEach(category => { %>
    <a href="/products?category=<%= category.name %>" class="category">
      <img src="<%= category.image %>" alt="<%= category.name %>">
      <p><%= category.name %></p>
    </a>
  <% }) %>
</div>
</section>

<section class="latest">
  <h2>Latest Products</h2>
  <div class="product-grid">
    <% latestProducts.forEach(product => { %>
      <div class="product-card" onclick="goToProduct('<%= product._id %>')">
        <div class="image-container">
          <img src="<%= product.images[0] %>" alt="<%= product.name %>">

          <% 
            const regular = product.variants.regularPrice;
            const sale = product.variants.salePrice;
            const hasDiscount = regular > sale;
            const discountPercent = hasDiscount 
              ? Math.round(((regular - sale) / regular) * 100) 
              : 0;
          %>

          <% if (hasDiscount) { %>
            <span class="offer-badge"><%= discountPercent %>% OFF</span>
          <% } %>
        </div>

        <h3><%= product.name %></h3>
        <p class="category"><%= product.category.name %></p>

        <div class="price">
          <span class="sale">₹<%= sale %></span>
          <% if (hasDiscount) { %>
            <span class="regular">₹<%= regular %></span>
          <% } %>
        </div>

        <!-- Rating -->
        <div class="rating">
          <% for (let i = 1; i <= 5; i++) { %>
            <% if (i <= product.avgRating) { %>
              <i class="fa-solid fa-star"></i>
            <% } else { %>
              <i class="fa-regular fa-star"></i>
            <% } %>
          <% } %>
        </div>

        <!-- Add to Cart Button -->
        <button 
          class="add-to-cart">Add to Cart</button>
      </div>
    <% }) %>
  </div>
</section>



<!--Coupon -->
<div class="newsletter">
  <h3>🎉 Get 10% OFF your first order!</h3>
  <p>Use code <span class="discount">WELCOME10</span> at checkout and enjoy exclusive updates.</p>
  <div class="newsletter-box">
     <a href="<%= user ? '/products' : '/signup' %>" class="btn">Shop Now</a>
  </div>
</div>



<!-- Skin Type -->
<section class="skin-type">
  <h2>Understand Your Skin Type</h2>
  <div class="skin-grid">
    <div class="skin-box">
      <img src="/images/PRQL_Blog_Hero_NormalSkin.webp" alt="Normal Skin" />
      <h4>Normal</h4>
      <p>Balanced, not too oily or dry. Minimal blemishes and even tone.</p>
    </div>
    <div class="skin-box">
      <img src="/images/PRQL_Blog_Hero_OilySkin.webp" alt="Oily Skin" />
      <h4>Oily</h4>
      <p>Produces excess sebum, leading to a shiny appearance and clogged pores.</p>
    </div>
    <div class="skin-box">
      <img src="/images/istockphoto-467680200-612x612.jpg" alt="Dry Skin" />
      <h4>Dry</h4>
      <p>Lacks moisture, often feels tight or flaky, may show fine lines.</p>
    </div>
    <div class="skin-box">
      <img src="/images/PRQL_Blog_Hero_CombinationSkin_1.jpg" alt="Combination Skin" />
      <h4>Combination</h4>
      <p>Oily in T-zone (forehead, nose, chin) and dry or normal elsewhere.</p>
    </div>
  </div>
</section>

<!-- Brands -->
<section class="brands">
  <h2>Brands</h2>
  <div class="brand-grid">
    <% brands.forEach(brand => { %>
      <div class="brand-card">
        <img src="<%= brand.logo %>" alt="<%= brand.name %>" />
        <p><%= brand.name %></p>
      </div>
    <% }) %>
  </div>
</section>



<%- include("../../views/partials/user/footer") %>
<script>
  function goToProduct(productId) {
  window.location.href = `/product/${productId}`;
}
</script>