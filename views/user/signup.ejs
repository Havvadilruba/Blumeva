<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account | Blumeva</title>
  <link rel="stylesheet" href="style/user/signup.css" />

  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</head>
<body>
  <div class="container">
    <header>
        <div class="logo">
  <img src="/images/Frame.svg" alt="Logo" class="logo-icon" />
  <span>Blumeva</span>
</div>
    </header>
    <h4 class="ph4">Create Your Blumeva Account</h4>

    
<% if (message) { %>
  <div class="backend-message">
    <%= message %>
  </div>
<% } %>

    <form class="form" id="signform" method="post" action="/signup" novalidate>
      <label for="name">Full Name</label>
      <input type="text" name="name" id="name" placeholder="Enter your full name" />
        <div id="error1" class="error-message" ></div>

      <label for="email">Email</label>
      <input type="text" name="email" id="email" placeholder="Enter your email" />
        <div id="error2" class="error-message"></div>


      <label for="password">Password</label>
      <div class="password-field">
        <input type="password" name="password" id="password" placeholder="Enter your password" />
        <i class="fa-regular fa-eye"></i>
      </div>
      <div id="error3" class="error-message"></div>

      <label for="confirm">Confirm Password</label>
      <div class="password-field">
        <input type="password" id="confirm" name="cpassword" placeholder="Confirm your password" />
        <i class="fa-regular fa-eye"></i>
      </div>
       <div id="error4" class="error-message"></div>

       <label for="referral">Referral Code (Optional)</label>
      <input type="text" name="referralCode" id="referral" placeholder="Enter referral code">
      <div id="error5" class="error-message"></div>


      <button type="submit" class="create-btn">Create Account</button>
    </form>

    <div class="divider">
      <span>Or sign up with</span>
    </div>

    <div class="social-login">
      <a href="auth/google" class="social-btn google">
        <i class="fa-brands fa-google"></i> Google
      </>
    </div>

    <p class="login-link">
      Already have an account?
      <a href="/login">Log in</a>
    </p>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="/js/user/signup.js"></script>
</body>
</html>
  

