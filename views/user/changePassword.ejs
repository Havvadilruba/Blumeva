<%- include("../partials/user/header") %>

<link rel="stylesheet" href="/style/user/changePassword.css" />

<section class="profile-section">
  <div class="profile-wrapper">

    <!-- Sidebar -->
    <%- include("../partials/user/sidebar", { activePage }) %>

    <div class="profile-container">
      <div class="header-section">
        <h2>Change Password</h2>
      </div>

      <% if (user?.googleId) { %>
        <!-- If Google Account -->
        <div class="google-info">
          <div class="google-icon">
            <i class="bi bi-google"></i>
          </div>
          <h3>This is a Google Account</h3>
          <p>Password is managed by Google. You cannot change it here.</p>
          <a href="/profile" class="back-btn">Back</a>
        </div>

      <% } else { %>
        <!-- Change Password Form -->
        <form id="changePasswordForm" class="password-form">

          <div class="form-group">
            <label>Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter current password" required />
          </div>

          <div class="form-group">
            <label>New Password</label>
            <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password" required />
          </div>

          <div class="form-group">
            <label>Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter new password" required />
          </div>

          <div class="button-row">
            <button type="button" id="savePasswordBtn" class="save-btn">Update Password</button>
            <a href="/profile" class="cancel-btn">Cancel</a>
          </div>

        </form>
      <% } %>

    </div>
  </div>
</section>

<%- include("../partials/user/footer") %>
<script src="/js/user/changePassword.js"></script>
