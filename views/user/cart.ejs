<%- include("../partials/user/header") %>

<div class="cart-container">
  <div class="cart-wrapper">

    <h1 class="cart-title">Shopping Cart</h1>

    <!-- Show checkout error message if exists -->
    <% if(typeof checkoutError !== 'undefined' && checkoutError) { %>
      <div class="alert alert-warning" style="background:#fff3cd;border:1px solid #ffc107;padding:12px 20px;border-radius:6px;margin-bottom:20px;color:#856404;">
        <strong>⚠️ <%= checkoutError %></strong>
      </div>
    <% } %>

    <div class="cart-layout">

      <!-- Cart Items -->
      <div class="cart-items-box">
        <% if(cart.items.length > 0) { %>
          <% cart.items.forEach(item => { %>

            <div class="cart-item" id="item-<%= item._id %>">

              <div class="cart-item-left">
                <img src="<%= item.images?.[0] %>" class="cart-item-image" alt="<%= item.product.name %>"/>

                <div class="cart-item-details">
                  <h3 class="cart-product-name"><%= item.product.name %></h3>

                  <div class="variant-tags">
                    <span class="tag"><%= item.variant.quantityValue %><%= item.variant.quantityType %></span>
                  </div>

                  <% if(item.stock > 0) { %>
                    <div class="qty-box">
                      <button 
                        class="qty-btn <%= item.quantity <= 1 ? 'disabled' : '' %>" 
                        onclick="changeQty('<%= item._id %>', 'minus')"
                        <%= item.quantity <= 1 ? 'disabled' : '' %>
                      >-</button>
                      <span class="qty-display"><%= item.quantity %></span>
                      <button 
                        class="qty-btn <%= item.quantity >= item.stock ? 'disabled' : '' %>" 
                        onclick="changeQty('<%= item._id %>', 'plus')"
                        data-stock="<%= item.stock %>"
                        <%= item.quantity >= item.stock ? 'disabled' : '' %>
                      >+</button>
                    </div>
                    
                    <!-- Show stock warning if quantity exceeds stock -->
                    <% if(item.quantity > item.stock) { %>
                      <p class="stock-warning" style="color:#d9534f;font-size:12px;margin-top:5px;font-weight:600;">
                        Only <%= item.stock %> available - Please decrease quantity
                      </p>
                    <% } else if(item.stock <= 5) { %>
                      <p class="stock-warning" style="color:#ff9800;font-size:12px;margin-top:5px;">
                        Only <%= item.stock %> left in stock
                      </p>
                    <% } %>
                  <% } %>

                  <% if(item.stock <= 0) { %>
                    <!-- MAIN out-of-stock marker used by JS to disable checkout -->
                    <p class="cart-out-of-stock" style="color:#d9534f;font-weight:600;">Out of Stock</p>
                  <% } %>
                </div>

              </div>

              <div class="cart-item-right">

                <% if(item.stock <= 0) { %>
                  <button class="remove-btn" onclick="removeItem('<%= item._id %>')">Remove</button>
                <% } else { %>
                  <button class="delete-btn" onclick="removeItem('<%= item._id %>')">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                <% } %>

                <div class="price-box" style="text-align:right;">
                  <% if(item.stock > 0) { %>

                    <%
                      const regular = item.regularPrice || 0;
                      const sale = item.salePrice || 0;
                      const offerAmount = item.discountAmount || 0;
                      const basePrice = sale > 0 ? sale : regular;
                      const currentRaw = basePrice - offerAmount;
                      const current = currentRaw > 0 ? currentRaw : 0;

                      const hasDiscount = regular > 0 && regular > current;
                      const discountPercent = hasDiscount
                        ? Math.round(((regular - current) / regular) * 100)
                        : 0;

                      const savingsPerUnit = current > 0
                        ? (regular > 0 ? (regular - current) : (basePrice - current))
                        : 0;
                    %>

                    <!-- FINAL PRICE -->
                    <div class="price" style="display:flex;flex-direction:column;align-items:flex-end;gap:3px;">

                      <!-- TOP PRICE LINE -->
                      <div style="display:flex;align-items:center;gap:8px;">
                        <span class="sale" style="font-size:18px;font-weight:700;color:#111;">
                          ₹<%= (current * item.quantity).toLocaleString('en-IN') %>
                        </span>

                        <% if(hasDiscount) { %>
                          <del class="regular"
                            style="font-size:14px;color:#888;text-decoration:line-through;">
                            ₹<%= (regular * item.quantity).toLocaleString('en-IN') %>
                          </del>
                        <% } %>
                      </div>

                      <!-- OFFER BADGE -->
                      <% if(hasDiscount) { %>
                        <span class="offer-badge"
                            style="background:#16a34a;color:#fff;font-size:11px;
                            padding:2px 6px;border-radius:4px;font-weight:600;">
                          <%= discountPercent %>% OFF
                        </span>
                      <% } %>

                      <!-- SAVE MESSAGE -->
                      <% if(item.discountAmount > 0) { %>
  <span style="color:#16a34a;font-size:12px;font-weight:600;">
    Save ₹<%= (savingsPerUnit * item.quantity).toLocaleString('en-IN') %> with offers
  </span>
<% } %>


                    </div>

                  <% } else { %>
                    <!-- This is only inside price box, JS ignores this class now -->
                    <p class="out-of-stock" style="color:#d9534f;font-weight:600;">Out of Stock</p>
                  <% } %>
                </div>

              </div>

            </div>

          <% }) %>
        <% } else { %>
          <h2 class="empty-cart">Your Cart is Empty</h2>
        <% } %>
      </div>

      <!-- Summary -->
      <div class="summary-box">
        <h2 class="summary-title">Order Summary</h2>

        <div class="summary-row">
          <span>Subtotal</span>
          <span id="summary-subtotal">₹<%= cart.subtotal.toLocaleString('en-IN') %></span>
        </div>

        <div class="summary-row saving">
          <span>Savings</span>
          <span id="summary-discount">-₹<%= cart.discount.toLocaleString('en-IN') %></span>
        </div>

        <div class="summary-row">
          <span>Tax</span>
          <span id="summary-tax">₹<%= cart.tax.toLocaleString('en-IN') %></span>
        </div>

        <hr class="summary-divider"/>

        <div class="summary-total">
          <span>Total</span>
          <span id="summary-total">₹<%= cart.total.toLocaleString('en-IN') %></span>
        </div>

        <% 
          const canCheckout = cart.items.length > 0 && 
                            !cart.items.some(i => i.stock <= 0) && 
                            !cart.items.some(i => i.quantity > i.stock);
        %>

        <% if(canCheckout) { %>
          <a href="/checkout" class="checkout-btn">Proceed to Checkout</a>
        <% } else { %>
          <div class="remove-message" style="color:#d9534f;text-align:center;margin-top:15px;font-weight:600;">
            <% if(cart.items.some(i => i.stock <= 0)) { %>
              Remove out of stock items to checkout
            <% } else if(cart.items.some(i => i.quantity > i.stock)) { %>
              Adjust quantities to available stock to checkout
            <% } %>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>

<script src="/js/user/cart.js"></script>
<%- include("../partials/user/footer") %>






