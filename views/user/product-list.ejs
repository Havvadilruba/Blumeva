<%- include("../partials/user/header") %>


<!-- Breadcrumbs -->
<nav class="breadcrumb">
  <a href="/">Home</a> ›
  <% if (query.category) { %>
    <a href="/products?category=<%= query.category %>"><%= query.category %></a>
    <% if (query.brand) { %>
      › <a href="/products?category=<%= query.category %>&brand=<%= query.brand %>"><%= query.brand %></a>
    <% } %>
  <% } else if (query.brand) { %>
    <a href="/products?brand=<%= query.brand %>"><%= query.brand %></a>
  <% } else { %>
    <span>All Products</span>
  <% } %>
</nav>

<section class="product-list-page">
  <div class="container">

    <aside class="sidebar">

    <!-- Category -->
    <div class="filter-block">
    <h4>Category</h4>
    <% categories.forEach(c => { %>
      <label onclick="categoryFilter(this)" name="<%= c.name %>">
        <input type="radio" name="category" value="<%= c.name %>"
          <%= query.category === c.name ? 'checked' : '' %> />
        <%= c.name %>
      </label>
    <% }) %>
  </div>

    <!-- Brand -->
      <div class="filter-block">
    <h4>Brand</h4>
    <% brands.forEach(b => { %>
      <label onclick="brandFilter(this)" name="<%= b.name %>">
        <input type="radio" name="brand" value="<%= b.name %>"
          <%= query.brand === b.name ? 'checked' : '' %> />
        <%= b.name %>
      </label>
    <% }) %>
  </div>


    <!-- Price -->
    <div class="filter-block">
    <h4>Price</h4>
    <div class="price-range">
      <input type="number" id="price-from" placeholder="Min" value="<%= query.priceMin || '' %>">
      <input type="number" id="price-to" placeholder="Max" value="<%= query.priceMax || '' %>">
      <button type="button" onclick="applyFilter()">Apply</button>
    </div>
  </div>

    <!--  Rating Filter -->
    <div class="filter-block">
    <h4>Rating</h4>
    <% [5,4,3,2,1].forEach(r => { %>
      <label onclick="ratingFilter(this)" name="<%= r %>">
        <input type="radio" name="rating" value="<%= r %>" <%= query.rating == r ? 'checked' : '' %> />
        <% for (let i=1;i<=5;i++){ %>
          <% if(i <= r){ %><i class="fa-solid fa-star"></i><% } else { %><i class="fa-regular fa-star"></i><% } %>
        <% } %>
      </label>
    <% }) %>
  </div>

    <!-- Buttons -->
   
  <button type="button" class="clear-btn" onclick="clearFilters()">Clear</button>

</aside>

    <!-- Main Product Section -->
    <main class="products">

      <!-- Top Controls -->
      <div class="top-controls">
        <div class="search-bar">
  <input 
    type="text" 
    id="search-input" 
    name="q" 
    placeholder="Search products..." 
    value="<%= query.q || '' %>" 
  />
  <% if (query.q) { %>
    <button type="button" id="clear-search">✕</button>
  <% } %>
</div>



          <div class="sort-dropdown">
    <label>Sort By:</label>
    <select id="sort-by" onchange="applyFilter()">
      <option value="">Default</option>
      <option value="new" <%= query.sort==='new' ? 'selected' : '' %>>New Arrivals</option>
      <option value="low" <%= query.sort==='low' ? 'selected' : '' %>>Price: Low to High</option>
      <option value="high" <%= query.sort==='high' ? 'selected' : '' %>>Price: High to Low</option>
      <option value="a-z" <%= query.sort==='a-z' ? 'selected' : '' %>>A → Z</option>
      <option value="z-a" <%= query.sort==='z-a' ? 'selected' : '' %>>Z → A</option>
      <option value="rating" <%= query.sort==='rating' ? 'selected' : '' %>>Top Rated</option>
    </select>
  </div>
</div>
      <div class="product-grid">
        <% if (products.length === 0) { %>
          <p>No products found.</p>
        <% } %>

        <% products.forEach(product => { %>
          <%- include("../partials/user/productCard", { product }) %>
        <% }) %>
      </div>


      <!-- Pagination -->
      <div class="pagination">
  <% if (currentPage > 1) { %>
    <button onclick="changePage(<%= currentPage - 1 %>)">Prev</button>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <button 
      onclick="changePage(<%= i %>)" 
      class="<%= i === currentPage ? 'active' : '' %>">
      <%= i %>
    </button>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <button onclick="changePage(<%= currentPage + 1 %>)">Next</button>
  <% } %>
</div>


    </main>
  </div>
</section>

<%- include("../partials/user/footer") %>
<script src="/js/user/product-list.js"></script>