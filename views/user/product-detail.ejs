<%- include("../partials/user/header") %>

<nav class="breadcrumb">
  <a href="/">Home</a> ›
  <a href="/products?category=<%= product.category.name %>"><%= product.category.name %></a> ›
  <a href="/products?category=<%= product.category.name %>&brand=<%= product.brand.name %>"><%= product.brand.name %></a> ›
  <span><%= product.name %></span>
</nav>

<section class="product-detail-container">

  <!-- Main Image  -->
  <div class="left-section">
    <div id="imageContainer" class="main-image-box">
      <img id="mainImage" src="<%= product.images[0] %>" alt="<%= product.name %>">
    </div>

    <div class="thumbnails">
      <% product.images.forEach((img, i) => { %>
        <img src="<%= img %>"
             onclick="changeImage('<%= img %>', event)"
             class="thumbnail <%= i===0 ? 'active' : '' %>">
      <% }) %>
    </div>
  </div>

  <!-- Details -->
  <div class="right-section">
    <h1 class="product-title"><%= product.name %></h1>
    <p class="brand">Brand: <span><%= product.brand.name %></span></p>

    <!-- Rating -->
    <div class="rating">
  <% for (let i = 1; i <= 5; i++) { %>
    <i class="fa-star <%= i <= Math.round(avgRating || 0) ? 'fas' : 'far' %>"></i>
  <% } %>
  <span>(Rating: <%= (avgRating || 0).toFixed(1) %>/5)</span>
</div>


    <% if (variant) { %>

    <%
  const offerAmount = offer || 0;

  const currentPrice = Math.max(
    0,
    variant.salePrice - offerAmount
  );

  const regular = variant.regularPrice || variant.salePrice;

  const totalDiscount = regular - currentPrice;

  const hasDiscount = totalDiscount > 0;

  const discountPercent = hasDiscount
    ? Math.round((totalDiscount / regular) * 100)
    : 0;
%>




      <!-- PRICE -->
      <div id="priceSection" class="price">
        <span class="sale">₹<%= currentPrice.toLocaleString('en-IN') %></span>
        <% if (hasDiscount) { %>
          <span class="regular">₹<%= variant.regularPrice.toLocaleString('en-IN') %></span>
          <span class="discount"><%= discountPercent %>% OFF</span>
          <p class="save-msg">
            Save ₹<%= (variant.regularPrice - currentPrice).toLocaleString('en-IN') %> 
          </p>
        <% } %>
      </div>

      <!-- STOCK  -->
      <div id="stockInfo">
        <% if (variant.stock <= 0) { %>
          <div class="stock out-stock-msg">
            <i class="fa-solid fa-circle-exclamation"></i> Out of Stock
          </div>
        <% } else if (variant.stock < 20) { %>
          <div class="stock low-stock-msg">
            <i class="fa-solid fa-clock"></i> Only <%= variant.stock %> left!
          </div>
        <% } else { %>
          <div class="stock in-stock-msg">
            <i class="fa-solid fa-check-circle"></i> In Stock
          </div>
        <% } %>
      </div>

      <!-- VARIANT BADGES -->
      <div class="variant-badges">
        <% product.variants.forEach((v, i) => { %>
          <span 
  class="variant-badge <%= v._id.toString() === variant._id.toString() ? 'active' : '' %>"
  data-variantid="<%= v._id %>"
  data-saleprice="<%= v.salePrice %>"
  data-regularprice="<%= v.regularPrice %>"
  data-stock="<%= v.stock %>"
  data-inwishlist="<%= product.wishlistedVariants?.some(w => w.toString() === v._id.toString()) %>"
>
  <%= v.quantityValue %> <%= v.quantityType %>
</span>

        <% }) %>
      </div>

      <div class="spacer"></div>
      <div class="actions">



  <!-- WISHLIST ICON -->
<button 
  class="wishlist-btn <%= isInWishlist ? 'active' : '' %>"
  onclick="toggleWishlist(event)">
  <i class="<%= isInWishlist ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
</button>


  <% if (variant.stock <= 0) { %>
    <button class="add-cart" disabled>
      Out of Stock
    </button>
  <% } else { %>
   <button class="add-cart" onclick="addToCart(event)">
  Add to Cart
</button>
  <% } %>

</div>


    <% } else { %>
      <button class="sold-out" disabled>Sold Out</button>
    <% } %>

    <div class="product-description">
      <h3>Description</h3>
      <p><%= product.description || 'No description available.' %></p>
    </div>

  </div>

</section>

<!-- You Might Also Like Section - FULL WIDTH -->
<% if (latestProducts && latestProducts.length > 0) { %>
<section class="you-might-like-section">
  <div class="container">
    <div class="you-might-like-header">
      <h2>
        <i class="fa-solid fa-heart-circle-check"></i>
        You Might Also Like
      </h2>
    </div>

    <div class="product-grid">
      <% latestProducts.slice(0, 4).forEach(product => { %>
        <%- include("../partials/user/productCard", { product }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Customer Reviews Section - FULL WIDTH -->
<section class="reviews-section">
  <div class="container">
    <div class="reviews-header">
      <h2>
        <i class="fa-solid fa-comments"></i>
        Customer Reviews
      </h2>
    </div>

    <% if (reviews && reviews.length > 0) { %>
      <div class="reviews-container">
        <% reviews.forEach(review => { %>
          <div class="review-card">
            <div class="review-header">
              <div class="reviewer-info">
                <div class="reviewer-avatar">
                  <%= review.userName ? review.userName.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="reviewer-details">
                  <h4><%= review.userName || 'Anonymous' %></h4>
                  <p class="review-date">
                    <i class="fa-regular fa-calendar"></i>
                    <%= new Date(review.date).toLocaleDateString('en-IN', { 
                      year: 'numeric', 
                      month: 'long', 
                      day: 'numeric' 
                    }) %>
                  </p>
                </div>
              </div>

              <div class="review-rating">
                <% for(let i = 1; i <= 5; i++) { %>
                  <i class="<%= i <= review.rating ? 'fa-solid' : 'fa-regular' %> fa-star <%= i <= review.rating ? '' : 'empty' %>"></i>
                <% } %>
              </div>
            </div>

            <div class="review-comment">
              <%= review.comment %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="no-reviews">
        <i class="fa-regular fa-comment-dots"></i>
        <p>No reviews yet. Be the first to share your experience!</p>
      </div>
    <% } %>
  </div>
</section>

<%- include("../partials/user/footer") %>
<script>
  window.productId = '<%= product._id %>';
  window.productOffers = <%- JSON.stringify(product.productOffer || []) %>;
  window.categoryOffers = <%- JSON.stringify(product.categoryOffer || []) %>;
</script>

<script src="/js/user/product-detail.js"></script>