<%- include('../partials/admin/sidebar') %>

<div class="container admin-referrals">
  <h2>Referral records</h2>

  <% if (referrals && referrals.length > 0) { %>
    <table class="admin-ref-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Referrer</th>
          <th>Referred</th>
          <th>Code Used</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% referrals.forEach((r, i) => { %>
          <tr>
            <td><%= i+1 %></td>
            <td><%= r.referrer?.name %> (<%= r.referrer?.email %>)</td>
            <td><%= r.referred?.name %> (<%= r.referred?.email %>)</td>
            <td><%= r.codeUsed %></td>
            <td><%= new Date(r.createdAt).toLocaleString('en-IN') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>No referrals yet</p>
  <% } %>
</div>

<script src="/js/admin/referrals.js"></script>
