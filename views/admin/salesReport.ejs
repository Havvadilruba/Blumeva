<div class="sales-report-container">
  <!-- Header Section -->
  <div class="report-header">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h1 class="page-title">Sales Report</h1>
        <p class="page-subtitle">Detailed overview of your sales transactions</p>
      </div>
      <div class="action-buttons">
        <button onclick="downloadPDF()" class="btn btn-pdf">
          <i class="fas fa-file-pdf"></i>
          <span>Download PDF</span>
        </button>
        <button onclick="downloadExcel()" class="btn btn-excel">
          <i class="fas fa-file-excel"></i>
          <span>Download Excel</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Filters Section - Auto-apply on change -->
  <div class="filters-section">
    <div class="filter-group">
      <label for="reportType">Report Type</label>
      <select id="reportType" class="form-control" onchange="applyFilters()">
        <option value="all" <%= reportType === 'all' ? 'selected' : '' %>>All Time</option>
        <option value="daily" <%= reportType === 'daily' ? 'selected' : '' %>>Today</option>
        <option value="weekly" <%= reportType === 'weekly' ? 'selected' : '' %>>This Week</option>
        <option value="monthly" <%= reportType === 'monthly' ? 'selected' : '' %>>This Month</option>
        <option value="yearly" <%= reportType === 'yearly' ? 'selected' : '' %>>This Year</option>
        <option value="custom" <%= reportType === 'custom' ? 'selected' : '' %>>Custom Range</option>
      </select>
    </div>

    <div class="filter-group">
      <label for="statusFilter">Order Status</label>
      <select id="statusFilter" class="form-control" onchange="applyFilters()">
        <option value="" <%= !statusFilter ? 'selected' : '' %>>All Statuses</option>
        <option value="Pending" <%= statusFilter === 'Pending' ? 'selected' : '' %>>Pending</option>
        <option value="Processing" <%= statusFilter === 'Processing' ? 'selected' : '' %>>Processing</option>
        <option value="Shipped" <%= statusFilter === 'Shipped' ? 'selected' : '' %>>Shipped</option>
        <option value="Delivered" <%= statusFilter === 'Delivered' ? 'selected' : '' %>>Delivered</option>
        <option value="Cancelled" <%= statusFilter === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
        <option value="Returned" <%= statusFilter === 'Returned' ? 'selected' : '' %>>Returned</option>
      </select>
    </div>

    <div id="customDateRange" class="filter-group" style="display: <%= reportType === 'custom' ? '' : 'none' %>">
      <label for="startDate">Start Date</label>
      <input 
        type="date" 
        id="startDate" 
        class="form-control" 
        value="<%= startDate %>"
        onchange="applyFilters()"
      />
    </div>

    <div id="customDateRange2" class="filter-group" style="display: <%= reportType === 'custom' ? '' : 'none' %>">
      <label for="endDate">End Date</label>
      <input 
        type="date" 
        id="endDate" 
        class="form-control" 
        value="<%= endDate %>"
        onchange="applyFilters()"
      />
    </div>

    <!-- No Apply/Clear buttons - auto-apply enabled -->
  </div>

  <!-- Summary Cards -->
  <div class="summary-cards">
    <div class="summary-card">
      <div class="card-icon orders">
        <i class="fas fa-shopping-cart"></i>
      </div>
      <div class="card-content">
        <h3><%= summary?.totalOrders || 0 %></h3>
        <p>Sales Orders</p>
      </div>
    </div>

    <div class="summary-card">
      <div class="card-icon sales">
        <i class="fas fa-rupee-sign"></i>
      </div>
      <div class="card-content">
        <h3>₹<%= summary.netSales.toFixed(2) %></h3>
        <p>Total Sales</p>
      </div>
    </div>

    <div class="summary-card">
      <div class="card-icon discounts">
        <i class="fas fa-tags"></i>
      </div>
      <div class="card-content">
        <h3>₹<%= (summary.totalDiscounts || 0).toFixed(2) %></h3>
        <p>Total Coupon Discounts</p>
      </div>
    </div>

    <div class="summary-card">
      <div class="card-icon products">
        <i class="fas fa-box"></i>
      </div>
      <div class="card-content">
        <h3><%= summary.productsSold %></h3>
        <p>Products Sold</p>
      </div>
    </div>
  </div>

  <!-- Table Section -->
  <div class="table-container">
    <table class="sales-table">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Customer</th>
          <th>Item</th>
          <th>Variant</th>
          <th>Qty</th>
          <th>Sale Price</th>
          <th>Offer Discount</th>
          <th>Coupon Discount</th>
          <th>Net Amount</th>
          <th>Payment</th>
          <th>Status</th>
          <th>Status Date</th>
        </tr>
      </thead>
      <tbody>
        <% if (report && report.length > 0) { %>
          <% report.forEach(row => { %>
            <tr>
              <td>
                <span class="font-semibold text-sm">#<%= row.orderId %></span>
              </td>
              <td>
                <div class="customer-info">
                  <strong><%= row.userName %></strong>
                  <small><%= row.userEmail %></small>
                </div>
              </td>
              <td><%= row.itemName %></td>
              <td><%= row.variantInfo %></td>
              <td class="text-center">
                <span class="font-semibold"><%= row.quantity %></span>
              </td>
              <td class="text-right">₹<%= row.salePrice.toFixed(2) %></td>
              <td class="text-right discount">₹<%= row.itemOfferDiscount.toFixed(2) %></td>
              <td class="text-right discount">₹<%= row.itemCouponShare.toFixed(2) %></td>
              <td class="text-right net-amount">₹<%= row.itemNetTotal.toFixed(2) %></td>
              <td>
                <span class="payment-badge <%= row.paymentMethod %>">
                  <%= row.paymentMethod.toUpperCase() %>
                </span>
              </td>
              <td>
                <span class="status-badge <%= row.itemStatus.toLowerCase().replace(/ /g, '-') %>">
                  <%= row.itemStatus %>
                </span>
              </td>
              <td>
                <%= row.statusDate
                  ? new Date(row.statusDate).toLocaleDateString("en-IN")
                  : "—" %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="12" class="text-center" style="padding: 3rem; color: #9ca3af; font-style: italic;">
              <i class="fas fa-inbox" style="font-size: 2rem; display: block; margin-bottom: 0.75rem; opacity: 0.3;"></i>
              No transactions found for the selected period
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <button onclick="changePage(<%= currentPage - 1 %>)" class="page-btn">
          <i class="fas fa-chevron-left"></i>
          <span>Previous</span>
        </button>
      <% } %>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
          <button 
            onclick="changePage(<%= i %>)" 
            class="page-btn <%= i === currentPage ? 'active' : '' %>"
          >
            <%= i %>
          </button>
        <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
          <span class="page-dots">...</span>
        <% } %>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <button onclick="changePage(<%= currentPage + 1 %>)" class="page-btn">
          <span>Next</span>
          <i class="fas fa-chevron-right"></i>
        </button>
      <% } %>
    </div>
  <% } %>
</div>

<!-- PDF Limit Modal -->
<div id="pdfModal" class="modal hidden">
  <div class="modal-content">
    <h3>Select PDF Limit</h3>
    <p>Choose how many orders to include in the PDF report:</p>
    
    <select id="pdfLimit" class="form-control">
      <!-- Options will be populated dynamically -->
    </select>

    <div id="pdfWarning" class="warning-message hidden">
      <i class="fas fa-exclamation-triangle"></i>
      <span>Large PDFs may take longer to generate</span>
    </div>

    <div class="modal-actions">
      <button onclick="confirmPdfDownload()" class="btn btn-primary">Download</button>
      <button onclick="closePdfModal()" class="btn btn-secondary">Cancel</button>
    </div>
  </div>
</div>

<script>
  // Make total orders available to JavaScript
  window.TOTAL_ORDERS = <%= totalTransactions || 0 %>;
</script>



<script src="/js/admin/salesReport.js"></script>