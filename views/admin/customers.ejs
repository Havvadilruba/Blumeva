<div class="header">
  <h1>Customers</h1>
</div>

<!-- STATS CARDS -->
<div class="stats-cards">
  <div class="card">
    <div class="icon"><i class="ri-user-line"></i></div>
    <div>
      <h2><%= totalCustomers %></h2>
      <p>Total Customers</p>
    </div>
  </div>

  <div class="card">
    <div class="icon active"><i class="ri-user-smile-line"></i></div>
    <div>
      <h2><%= activeCustomers %></h2>
      <p>Active Customers</p>
    </div>
  </div>

  <div class="card">
    <div class="icon blocked"><i class="ri-user-unfollow-line"></i></div>
    <div>
      <h2><%= blockedCustomers %></h2>
      <p>Blocked Customers</p>
    </div>
  </div>
</div>

<!-- SEARCH BAR -->
<div class="customer-table">
  <div class="table-header">
    <input type="text" id="searchInput" placeholder="🔍 Search by name or email" />
  </div>

  <!-- CUSTOMER TABLE -->
  <table>
    <thead>
      <tr>
        <th>Customer Name</th>
        <th>Email</th>
        <th>Orders</th>
        <th>Total Spent</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>

    <tbody>
      <% customers.forEach((customer) => { %>
        <tr>
          <td class="customer-info">
            <img src="<%= customer.avatar || 'https://via.placeholder.com/40' %>" alt="Avatar" />
            <span><%= customer.name %></span>
          </td>
          <td><%= customer.email %></td>
          <td><%= customer.orders || 0 %></td>
          <td>₹<%= customer.totalSpent?.toFixed(2) || '0.00' %></td>
          <td>
            <span class="status <%= customer.isBlocked ? 'blocked' : 'active' %>">
              <%= customer.isBlocked ? 'Blocked' : 'Active' %>
            </span>
          </td>
          <td class="actions">
            <a href="/admin/customers/<%= customer._id %>" class="view" title="View Details">
              <i class="ri-eye-line"></i>
            </a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <!-- PAGINATION -->
  <div class="pagination">
    <% if (currentPage > 1) { %>
      <a href="?page=<%= currentPage - 1 %>&search=<%= search %>" class="page-btn">« Previous</a>
    <% } else { %>
      <button disabled class="page-btn disabled">« Previous</button>
    <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
      <% if (i === currentPage) { %>
        <button class="page-btn active"><%= i %></button>
      <% } else { %>
        <a href="?page=<%= i %>&search=<%= search %>" class="page-btn"><%= i %></a>
      <% } %>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <a href="?page=<%= currentPage + 1 %>&search=<%= search %>" class="page-btn">Next »</a>
    <% } else { %>
      <button disabled class="page-btn disabled">Next »</button>
    <% } %>
  </div>
</div>

<script>
  const searchInput = document.getElementById('searchInput');
  const tbody = document.querySelector('.customer-table tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));

  searchInput.addEventListener('input', function () {
    const searchValue = this.value.toLowerCase().trim();

    rows.forEach(row => {
      const name = row.querySelector('.customer-info span').innerText.toLowerCase().trim();
      
      if (name.startsWith(searchValue) || searchValue === '') {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });
</script>

