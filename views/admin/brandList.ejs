<section class="brand-page">
  <div class="page-header">
    <h1>Brands Management</h1>

    <form id="searchForm" method="GET" action="/admin/brands" class="search-form">
      <input type="text" id="searchInput" name="search" value="<%= search %>" placeholder="🔍 Search brands..."autocomplete="off"/>
      <button type="button" id="clearSearch" class="btn-clear">✖ Clear</button>
    </form>



    <button class="btn btn-primary" id="openAddBrandModal">+ Add Brand</button>
  </div>

  <!-- Brand Table -->
  <table class="brand-table">
    <thead>
      <tr>
        <th>Logo</th>
        <th>Brand Name</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (brands.length > 0) { %>
        <% brands.forEach(brand => { %>
          <tr>
            <td><img src="<%= brand.logo %>" class="brand-logo" /></td>
            <td><%= brand.name %></td>
            <td>
              <span class="status-badge <%= brand.status ? 'active' : 'inactive' %>">
                <%= brand.status ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td>
              <button class="edit-btn"
                onclick="openEditModal('<%= brand._id %>', '<%= brand.name %>', '<%= brand.logo %>', <%= brand.status %>)">
                <i class="ri-edit-line"></i> Edit
              </button>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="4">No brands found</td></tr>
      <% } %>
    </tbody>
  </table>

  <!-- Pagination -->
  <div class="pagination">
     <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage - 1 %>&search=<%= search %>" class="page-btn prev">« Prev</a>
  <% } else { %>
    <button disabled class="page-btn disabled prev">« Prev</button>
  <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
      <% if (i === currentPage) { %>
        <button class="page-btn active"><%= i %></button>
      <% } else { %>
        <a href="?page=<%= i %>&search=<%= search %>" class="page-btn"><%= i %></a>
      <% } %>
    <% } %>

    <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage + 1 %>&search=<%= search %>" class="page-btn next">Next »</a>
  <% } else { %>
    <button disabled class="page-btn disabled next">Next »</button>
  <% } %>
  </div>
</section>

<!-- Add Brand Modal -->
<div class="modal" id="addBrandModal">
  <div class="modal-content">
    <h2>Add Brand</h2>
    <form id="addBrandForm" enctype="multipart/form-data">
      <div class="form-group">
        <label>Brand Name</label>
        <input type="text" name="name" placeholder="Enter brand name" required>
      </div>

      <div class="form-group">
        <label>Logo</label>
        <input type="file" name="logo" accept="image/*" required>
      </div>

      <div class="form-group">
        <label>Status</label>
        <select name="status">
          <option value="on">Active</option>
          <option value="off">Inactive</option>
        </select>
      </div>

      <div class="form-actions">
        <button type="button" id="cancelAddModal" class="btn cancel">Cancel</button>
        <button type="submit" class="btn save">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Brand Modal -->
<div class="modal" id="editBrandModal">
  <div class="modal-content">
    <h2>Edit Brand</h2>
    <form id="editBrandForm" enctype="multipart/form-data">
      <div class="form-group">
        <label>Brand Name</label>
        <input type="text" id="editBrandName" name="name" required>
      </div>

      <div class="form-group">
        <label>Current Logo</label>
        <img id="editBrandLogoPreview" src="" class="preview-logo" />
      </div>

      <div class="form-group">
        <label>Change Logo</label>
        <input type="file" name="logo" accept="image/*">
      </div>

      <div class="form-group">
        <label>Status</label>
        <select name="status" id="editBrandStatusSelect">
          <option value="on">Active</option>
          <option value="off">Inactive</option>
        </select>
      </div>

      <div class="form-actions">
        <button type="button" id="cancelEditModal" class="btn cancel">Cancel</button>
        <button type="submit" class="btn save">Update</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/admin/brand.js"></script>
