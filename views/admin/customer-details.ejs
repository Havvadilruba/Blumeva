<%- include('../partials/admin/sidebar') %>

<div class="content">
  <div class="card">
    <div class="card-header">
      <h2>Customer Details</h2>
      <p>Viewing details for <%= customer.name %></p>
    </div>

    <div class="card-body">
      <h3>Personal Information</h3>
      <div class="info-grid">
        <p><strong>Full Name:</strong> <%= customer.name %></p>
        <p><strong>Email Address:</strong> <%= customer.email %></p>
        <p><strong>Phone Number:</strong> <%= customer.phone || '-' %></p>
        <p><strong>Address:</strong> <%= customer.address || '-' %></p>
      </div>

      <div class="actions">
        <a href="/admin/customers" class="btn btn-secondary">Back</a>

        <!-- Button -->
        <button
          id="blockToggleBtn"
          class="btn <%= customer.isBlocked ? 'btn-success' : 'btn-danger' %>"
          data-id="<%= customer._id %>"
          data-status="<%= customer.isBlocked %>">
          <%= customer.isBlocked ? 'Unblock Customer' : 'Block Customer' %>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmModal" class="modal">
  <div class="modal-content">
    <h3 id="confirmTitle">Confirm Action</h3>
    <p id="confirmMessage">Are you sure you want to do this?</p>
    <div class="modal-actions">
      <button id="confirmCancel" class="btn cancel">Cancel</button>
      <button id="confirmOk" class="btn confirm">Yes, Confirm</button>
    </div>
  </div>
</div>


<script src="/js/admin/customer.js"></script>

