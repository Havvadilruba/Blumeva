<%- include('../partials/admin/sidebar', { activePage: 'categoryList' }) %>

<div class="main-content">
  <header class="page-header">
    <h2>Manage Product Categories</h2>
    <a href="/admin/category/add" class="btn-primary">
      <i class="ri-add-line"></i> Add New Category
    </a>
  </header>
  <div class="search-bar">
  <input type="text" id="searchInput" placeholder="🔍 Search category by name" />
</div>
  <section class="category-container">
    <table class="category-table">
      <thead>
        <tr>
          <th>Image</th>
          <th>Category Name</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (categories.length > 0) { %>
          <% categories.forEach(cat => { %>
            <tr>
              <td><img src="<%= cat.image %>" alt="<%= cat.name %>" class="cat-thumb"></td>
              <td><%= cat.name %></td>
              <td>
                <span class="<%= cat.isListed ? 'status-active' : 'status-blocked' %>">
                  <%= cat.isListed ? 'Active' : 'Blocked' %>
                </span>
              </td>
              <td>
                <a href="/admin/category/edit/<%= cat._id %>" class="btn-edit">
                  <i class="ri-edit-line"></i>
                </a>

                <form action="/admin/category/toggle/<%= cat._id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn-toggle <%= cat.isListed ? 'btn-block' : 'btn-unblock' %>">
                    <i class="<%= cat.isListed ? 'ri-close-circle-line' : 'ri-check-line' %>"></i>
                    <%= cat.isListed ? 'Block' : 'Unblock' %>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" class="no-data">No categories found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <div class="pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %>" class="<%= currentPage === i ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </div>
  </section>
</div>
<script>
  // Search 
  const searchInput = document.getElementById('searchInput');
  const tableRows = document.querySelectorAll('.category-table tbody tr');

  searchInput.addEventListener('input', function () {
    const searchValue = this.value.toLowerCase().trim();

    tableRows.forEach(row => {
      const categoryName = row.querySelector('td:nth-child(2)').innerText.toLowerCase();
      row.style.display = categoryName.startsWith(searchValue) || searchValue === '' ? '' : 'none';
    });
  });
</script>
