<%- include('../partials/admin/sidebar', { activePage: 'categoryList' }) %>

<div class="main-content">
  <header class="page-header">
    <h2>Manage Product Categories</h2>
    <a href="/admin/category/add" class="btn-primary">
      <i class="ri-add-line"></i> Add New Category
    </a>
  </header>

  <div class="search-bar">
  <form id="searchForm" method="GET" action="/admin/category">
    <input
      type="text"
      id="searchInput"
      name="search"
      value="<%= search || '' %>"
      placeholder="🔍 Search category by name"
      autocomplete="off"
    />
    <button type="button" id="clearSearch" class="clear-btn">✖ Clear</button>
  </form>
</div>

  <section class="category-container">
    <table class="category-table">
      <thead>
        <tr>
          <th>Image</th>
          <th>Category Name</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (categories.length > 0) { %>
          <% categories.forEach(cat => { %>
            <tr>
              <td><img src="<%= cat.image %>" alt="<%= cat.name %>" class="cat-thumb"></td>
              <td><%= cat.name %></td>
              <td>
                <span class="<%= cat.isListed ? 'status-active' : 'status-blocked' %>">
                  <%= cat.isListed ? 'Active' : 'Blocked' %>
                </span>
              </td>
              <td>
                <a href="/admin/category/edit/<%= cat._id %>" class="btn-edit">
                  <i class="ri-edit-line"></i>
                </a>

                <form style="display:inline;">
                  <button 
                    type="button"
                    class="btn-toggle <%= cat.isListed ? 'btn-block' : 'btn-unblock' %>"
                    data-id="<%= cat._id %>">
                    <i class="<%= cat.isListed ? 'ri-close-circle-line' : 'ri-check-line' %>"></i>
                    <%= cat.isListed ? 'Block' : 'Unblock' %>
                  </button>
                </form>

              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" class="no-data">No categories found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage - 1 %>&search=<%= search %>">« Prev</a>
  <% } else { %>
    <button disabled class="disabled">« Prev</button>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <% if (i === currentPage) { %>
      <button class="active"><%= i %></button>
    <% } else { %>
      <a href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
    <% } %>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage + 1 %>&search=<%= search %>">Next »</a>
  <% } else { %>
    <button disabled class="disabled">Next »</button>
  <% } %>
</div>

  </section>
</div>
<script src="/js/admin/category.js"></script>
